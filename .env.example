# ===== Eco-Research Copilot 环境变量模板 =====
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥

# ---- 大模型 ----
# 必填。DeepSeek / 兼容 OpenAI 协议模型的 API Key
DEEPSEEK_API_KEY=sk-your-api-key-here

# API 网关地址（可选；留空则使用官方 DeepSeek：https://api.deepseek.com）
BASE_URL=

# 模型名称（可选；留空则使用官方模型 deepseek-chat）
MODEL_NAME=

# 备用模型（可选；主模型重试耗尽后自动切换降级，留空则不启用）
BACKUP_MODEL=

# ---- 搜索工具 ----
# 可选值：tavily / ddg
SEARCH_PROVIDER=tavily

# Tavily 搜索 API Key（使用 tavily 时必填）
TAVILY_API_KEY=tvly-your-api-key-here

# DuckDuckGo 搜索代理（可选；仅国内网络使用 ddg 时填写，如 http://127.0.0.1:7890）
DDG_PROXY=

# ---- 业务边界控制 ----
# 采集-质检循环的最大轮数（1-5）
MAX_COLLECT_ROUNDS=3

# 撰写-逻辑稽核交叉校验的最大轮数（1-5）
WRITE_AUDIT_ROUNDS=2

# 事实稽核官分批提炼：每批证据条数（防长 prompt 触发思维链爆 token）
EVIDENCE_BATCH_SIZE=5

# 阶段级自动重试次数：单阶段失败后自动重试 N 次
STAGE_RETRY=2

# 是否开启质量门禁（防幻觉熔断）：True / False
REQUIRE_STRICT_EVIDENCE=True

# ---- 报告生成 ----
# 正文模式：standard（快，一次性）/ deep（分章，更充实）
REPORT_MODE=standard

# 交付格式：docx（Word）/ markdown
REPORT_FORMAT=docx

# 人机协同模式：auto（全自动，默认）/ manual（三阶段确认：框架→素材→终稿）
REVIEW_MODE=auto

# ---- 报告模板自定义（Word / PDF 通用；留空 = 用内置默认） ----
# 免责声明（空 = 用内置默认）
REPORT_DISCLAIMER=
# 页眉文本（空 = 用报告标题）
REPORT_HEADER=
# 页脚文本（空 = 用自动页码）
REPORT_FOOTER=
# Logo 图片路径（空 = 不显示）
REPORT_LOGO=

# ---- 限流保护 ----
API_RATE_LIMIT_SECONDS=5
MAX_RETRY_WAIT_SECONDS=30
